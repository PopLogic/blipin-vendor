default_platform(:ios)

platform :ios do

  desc "Get the last commit message from the current branch"
  def get_branch_last_commit
    `git log -1 --pretty=%B`.strip
  end

  desc "Upload to TestFlight"
  require "json"

  lane :staging_validation do |options|
    scheme = options[:scheme] || "staging"
    app_id = "com.poplogic.blipinVendor.staging"


    # 1. Create a temporary, unlocked keychain for CI
    keychain_name = "login.keychain"
    keychain_password = "1224"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600, # Keep unlocked for 1 hour
      lock_when_sleeps: false
    )

    # 1. Native Base64 key handling using Fastlane's built-in parameter
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )

    # 2. Query build number explicitly for this Bundle Identifier
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_id
    ) + 1

    # 3. Explicitly target Runner.xcodeproj when running inside /ios directory
    increment_build_number(
      build_number: build_number,
      xcodeproj: "Runner.xcodeproj"
    )

    # 4. Use readonly mode for CI to prevent git state errors
    match(
      type: "appstore",
      app_identifier: app_id,
      api_key: api_key,
      git_url: ENV["MATCH_GIT_URL"],
      force_legacy_encryption: true,
      readonly: true,
      keychain_name: keychain_name,
      keychain_password: keychain_password
    )

    # 5. Build iOS App
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "staging",
      configuration: "Release-staging",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Runner.ipa",
      clean: true,
      xcargs: "ALLOW_PROVISIONING_UPDATES=NO",
    )

    # 6. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      changelog: get_branch_last_commit,
      groups: ["Blipin Vendor Testers"],
      skip_waiting_for_build_processing: true
    )

    # 7. Safe Webhook Execution via Net::HTTP (prevents shell single-quote escaping issues in commit messages)
    commit_msg = get_branch_last_commit
    payload = {
      username: "Github Action",
      content: "A new TestFlight build has been uploaded 🚀",
      avatar_url: "https://poplogic.github.io/assets/ic_launcher.png",
      embeds: [
        {
          title: "TestFlight Upload",
          color: 0x007AFF,
          fields: [
            { name: "Scheme", value: scheme, inline: true },
            { name: "Build Number", value: build_number.to_s, inline: true },
            { name: "Release Notes", value: commit_msg, inline: false },
            { name: "App Store Connect", value: "https://appstoreconnect.apple.com/apps", inline: false }
          ]
        }
      ]
    }

    uri = URI.parse(ENV["DISCORD_WEBHOOK_URL"])
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = (uri.scheme == "https")

    request = Net::HTTP::Post.new(uri.request_uri, { 'Content-Type' => 'application/json' })
    request.body = payload.to_json
    http.request(request)

    delete_keychain(name: keychain_name)
  end

desc "Get the last commit message from the current branch"
  lane :get_branch_last_commit_with_ui do
      last_commit = `git log -1 --pretty=%B`.strip
      UI.message("Last commit message: #{last_commit}")
      last_commit
  end

  desc "Build and distribute stagingValidation APK"
    lane :staging_validation_apk do

#       increment_version
      gradle(
        task: "assemble",
        build_type: "validation",
        flavor: "staging"
      )
      apk = Actions.lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
      UI.user_error!("APK output path was not found after assemble.") unless apk

      last_release = firebase_app_distribution(
        app: ENV["FIREBASE_APP_ID"],
        service_credentials_file: ENV["FIREBASE_CREDENTIALS_JSON_PATH"],
        groups: "internal-testers-1",
        release_notes: get_branch_last_commit_with_ui,
        apk_path: apk
      )

        release_notes = last_release && last_release[:releaseNotes] && last_release[:releaseNotes][:text] ? last_release[:releaseNotes][:text] : "No release notes provided."
        display_version = last_release && last_release[:displayVersion] ? last_release[:displayVersion] : "N/A"
        build_version = last_release && last_release[:buildVersion] ? last_release[:buildVersion] : "N/A"
        testing_uri = last_release && last_release[:testingUri] ? last_release[:testingUri] : "N/A"

        require "json"

        payload = {
          username: "Github Action",
          content: "A new alpha APK has been uploaded to Firebase App Distribution. Check it out:",
          avatar_url: "https://poplogic.github.io/assets/ic_launcher.png",
          embeds: [
            {
              title: "Release Notes",
              description: release_notes,
              color: 0xff6600,
              fields: [
                {
                  name: "Display Version",
                  value: display_version.to_s,
                  inline: true
                },
                {
                  name: "Build Version",
                  value: build_version.to_s,
                  inline: true
                },
                {
                  name: "Testing URI",
                  value: testing_uri.to_s,
                  inline: false
                }
              ]
            }
          ]
        }

        sh("curl -sS -X POST '#{ENV["DISCORD_WEBHOOK_URL"]}' -H 'Content-Type: application/json' -d '#{payload.to_json}'")
      end

end