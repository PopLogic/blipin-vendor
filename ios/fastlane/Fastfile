default_platform(:ios)

require "json"
require "net/http"
require "uri"

def get_branch_last_commit
  `git log -1 --pretty=%B`.strip
end

platform :ios do
  desc "Build and upload the Staging flavor to TestFlight"
  lane :staging_validation do |options|
    scheme = options[:scheme] || "staging"
    configuration = "Release-#{scheme}"
    app_id = "com.poplogic.blipinVendor.staging"

    # Authenticate with App Store Connect
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY"],
      is_key_content_base64: true
    )

    commit_msg = get_branch_last_commit

    # Determine next TestFlight build number
    build_number =
      latest_testflight_build_number(
        api_key: api_key,
        app_identifier: app_id
      ).to_i + 1

    increment_build_number(
      build_number: build_number,
      xcodeproj: "Runner.xcodeproj"
    )

    # Build the IPA
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: scheme,
      configuration: configuration,
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "Runner.ipa",
      xcargs: "ALLOW_PROVISIONING_UPDATES=NO"
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      changelog: commit_msg,
      skip_waiting_for_build_processing: true
    )

    # Discord notification
    payload = {
      username: "GitHub Actions",
      content: "🚀 A new TestFlight build has been uploaded.",
      avatar_url: "https://poplogic.github.io/assets/ic_launcher.png",
      embeds: [
        {
          title: "TestFlight Upload",
          color: 0x007AFF,
          fields: [
            {
              name: "Scheme",
              value: scheme,
              inline: true
            },
            {
              name: "Configuration",
              value: configuration,
              inline: true
            },
            {
              name: "Build Number",
              value: build_number.to_s,
              inline: true
            },
            {
              name: "Release Notes",
              value: commit_msg,
              inline: false
            },
            {
              name: "App",
              value: app_id,
              inline: false
            },
            {
              name: "App Store Connect",
              value: "https://appstoreconnect.apple.com/apps",
              inline: false
            }
          ]
        }
      ]
    }

    uri = URI.parse(ENV["DISCORD_WEBHOOK_URL"])

    Net::HTTP.start(
      uri.host,
      uri.port,
      use_ssl: uri.scheme == "https"
    ) do |http|
      request = Net::HTTP::Post.new(
        uri.request_uri,
        "Content-Type" => "application/json"
      )
      request.body = payload.to_json
      response = http.request(request)

      UI.message("Discord notification sent (#{response.code})")
    end
  end
end