default_platform(:android)

platform :android do

  desc "Last commit message"
  lane :get_branch_last_commit_with_ui do
    last_commit = `git log -1 --pretty=%B`.strip
    UI.message(last_commit)
    last_commit
  end

  desc "Upload existing Flutter APK to Firebase"
  lane :upload_validation do

    apk = File.join(
      ENV["GITHUB_WORKSPACE"],
      "build",
      "app",
      "outputs",
      "flutter-apk",
      "app-staging-release.apk"
    )

    UI.user_error!("APK not found: #{apk}") unless File.exist?(apk)

    UI.success("Found APK:")
    UI.message(apk)

    last_release = firebase_app_distribution(
      app: ENV["FIREBASE_APP_ID"],
      service_credentials_file: ENV["FIREBASE_CREDENTIALS_JSON_PATH"],
      groups: "internal-tester",
      release_notes: get_branch_last_commit_with_ui,
      apk_path: apk
    )

    release_notes = last_release&.dig(:releaseNotes, :text) || "No release notes"
    display_version = last_release&.dig(:displayVersion) || "N/A"
    build_version = last_release&.dig(:buildVersion) || "N/A"
    testing_uri = last_release&.dig(:testingUri) || "N/A"

    require "json"

    payload = {
      username: "Github Action",
      avatar_url: "https://poplogic.github.io/assets/ic_launcher.png",
      content: "A new Validation APK has been uploaded.",
      embeds: [
        {
          title: "Firebase App Distribution",
          color: 0xff6600,
          description: release_notes,
          fields: [
            {
              name: "Display Version",
              value: display_version.to_s,
              inline: true
            },
            {
              name: "Build Version",
              value: build_version.to_s,
              inline: true
            },
            {
              name: "Testing URL",
              value: testing_uri.to_s,
              inline: false
            }
          ]
        }
      ]
    }

    sh(
      "curl -sS -X POST '#{ENV['DISCORD_WEBHOOK_URL']}' " \
      "-H 'Content-Type: application/json' " \
      "-d '#{payload.to_json}'"
    )
  end

end